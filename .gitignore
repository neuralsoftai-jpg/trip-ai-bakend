# ═══════════════════════════════════════════════════════════════════
#  AI TRIP PLANNER — .gitignore
#  Excludes build artifacts, secrets, IDE files, and local configs
# ═══════════════════════════════════════════════════════════════════

# ─── Java / Maven ───────────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.zip
*.tar.gz
*.rar

# ─── Spring Boot Secrets (NEVER commit real keys) ───────────────────
src/main/resources/application-local.yml
src/main/resources/application-secret.yml
src/main/resources/*.properties.local

# ─── IntelliJ IDEA ──────────────────────────────────────────────────
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# ─── Eclipse ────────────────────────────────────────────────────────
.project
.classpath
.settings/
.factorypath

# ─── VS Code ────────────────────────────────────────────────────────
.vscode/
!.vscode/extensions.json

# ─── Next.js Frontend ───────────────────────────────────────────────
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/

# ─── Frontend Environment Files (contain secrets) ───────────────────
frontend/.env
frontend/.env.local
frontend/.env.production
frontend/.env.development
# Keep .env.example (it's a template, no secrets)
!frontend/.env.example

# ─── macOS ──────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ─── Logs ───────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Runtime ────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock

# ─── Test Coverage ──────────────────────────────────────────────────
coverage/
.nyc_output/
htmlcov/
.pytest_cache/

# ─── Misc ───────────────────────────────────────────────────────────
*.swp
*.swo
*~
.agent/
.gemini/
trip-planner/
